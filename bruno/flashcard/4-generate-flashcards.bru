meta {
  name: Flashcards - generate for tag
  type: http
  seq: 4
}

docs {
  Requires {{tagId}} — run "1-create-tag" first.
  Saves the first created flashcard's id into {{cardId}} for later requests.
}

post {
  url: {{baseUrl}}/tags/{{tagId}}/flashcards/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "limit": 3
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns flashcards with image + ai sentences", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.flashcards).to.be.an("array").with.length.greaterThan(0);
    body.data.flashcards.forEach((f) => {
      expect(f.image_url).to.be.a("string").and.not.empty;
      expect(f.ai_suggested_sentences).to.be.an("array");
    });
  });
}

script:post-response {
  if (res.getStatus() === 201) {
    const cards = res.getBody().data.flashcards;
    if (cards && cards.length > 0) {
      bru.setVar("cardId", cards[0].id);
    }
  }
}
