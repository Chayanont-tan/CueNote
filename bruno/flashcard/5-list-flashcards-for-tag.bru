meta {
  name: Flashcards - list for tag
  type: http
  seq: 5
}

docs {
  Requires {{tagId}} — run "4-generate-flashcards" first.
}

get {
  url: {{baseUrl}}/tags/{{tagId}}/flashcards
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array of flashcards", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array");
  });
}
