meta {
  name: Tags - get by id
  type: http
  seq: 3
}

docs {
  Requires {{tagId}} — run "1-create-tag" first.
}

get {
  url: {{baseUrl}}/tags/{{tagId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the tag", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(String(body.data.id)).to.equal(String(bru.getVar("tagId")));
  });
}
