meta {
  name: Tags - list (home)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/tags?limit=5
  body: none
  auth: bearer
}

params:query {
  limit: 5
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("success is true", function () {
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Requires a valid {{token}}. Only returns tags this user has at least one
  flashcard for — run "3-generate-flashcards" first if this comes back empty.
}
